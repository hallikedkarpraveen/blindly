{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/download",
      "destination": "/?waitlist=true&src=Download",
      "permanent": false
    },
    {
      "source": "/product",
      "destination": "/#product",
      "permanent": false
    },
    {
      "source": "/why",
      "destination": "/#why",
      "permanent": false
    },
    {
      "source": "/stories",
      "destination": "/#stories",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/c/:code",
      "destination": "https://velvet-backend-fvpw.onrender.com/c/:code"
    },
    {
      "source": "/r/:code",
      "destination": "https://velvet-backend-fvpw.onrender.com/r/:code"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account.html"
    }
  ],
  "headers": [
    {
      "source": "/(c|r)/:code",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/(support|image-slot)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.*|apple-touch-icon.*|icon-.*|og\\.png|site\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
